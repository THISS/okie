# Copy to .dev.vars (gitignored) for local QA with `pnpm --filter @okie/edge dev` (port 4196).
# The DEV_* names are local-only and must never be set in wrangler.jsonc.

# Browsing (the whole launch scope) needs none of these: /scan, /r, /og, /oembed and source.json are
# served from the local R2 bucket (and GitHub raw for source.json).

# "1" turns signed-in Ask on locally. Block-plan stays independently disabled.
# ASK_ENABLED=1
# BLOCK_PLAN_ENABLED=0

# Proxy POST /api/ask, /api/block-plan and neighborhood pack misses to a locally running apps/server
# instead of the (Docker) container. Leave empty for no backend (Ask answers 503, pack misses 404).
DEV_BACKEND_ORIGIN=http://127.0.0.1:4195

# "1" exposes GET /__store/<key> (public AND private objects) so a local apps/server can mirror the
# local R2 bucket from http://127.0.0.1:4196/__store. Anything else keeps the route a 404.
DEV_STORE_ROUTE=1

# Cloudflare Web Analytics beacon on every HTML page (production sets the real site token in
# wrangler.jsonc). A fake 16-64 character alphanumeric token shows the injected <script> locally; the
# beacon then fails to report, which is expected.
# WEB_ANALYTICS_TOKEN=0123456789abcdef0123456789abcdef

# GitHub sign-in (CLA-316). Off unless SESSION_SIGNING_KEY (>= 32 chars) is set AND either a GitHub OAuth
# app (GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET, callback http://127.0.0.1:4196/api/auth/github/callback) or
# DEV_AUTH_TEST_LOGIN=1 (a fixed test user, loopback only). Accounts live in the local D1 database; create its
# table once with `pnpm exec wrangler d1 migrations apply USERS_DB --local`.
# SESSION_SIGNING_KEY=local-dev-signing-key-change-me-0123456789
# DEV_AUTH_TEST_LOGIN=1
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
