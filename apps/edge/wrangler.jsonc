// sourcefor.dev edge Worker (CLA-266). Top level = local dev (`pnpm --filter @okie/edge dev`);
// `env.staging` / `env.production` are the deployed environments. Bindings, vars, containers,
// durable_objects, r2_buckets, d1_databases and ratelimits are NOT inherited by named environments, so each env
// repeats them.
// Launch is BROWSE-ONLY: staging/production have no `containers` and no ATLAS_API binding, and
// ASK_ENABLED is "0" (Ask/block-plan 404 at the edge; browsing is served entirely from R2). The top
// level keeps the container so the signed-in-Ask follow-up stays testable locally; set ASK_ENABLED=1
// in .dev.vars to try it. Secrets (OKIE_LLM_API_KEY, JEV_API, TURNSTILE_SECRET_KEY, plus the sign-in
// secrets below) are set with `wrangler secret put --env <env>`; DEV_BACKEND_ORIGIN, DEV_STORE_ROUTE and
// DEV_AUTH_TEST_LOGIN only ever come from a local .dev.vars and must never appear here (asserted in
// test/config.test.ts).
// Cloudflare Web Analytics (CLA-318): WEB_ANALYTICS_TOKEN (the dashboard's site token; public, it ships
// in page HTML) turns on the beacon in every HTML page the Worker serves (src/analytics.ts). Production
// only: it is set in env.production.vars; remove it and redeploy to turn analytics off. Unset, blank or
// not /^[A-Za-z0-9]{16,64}$/ = no analytics. Staging and local dev stay without.
// Use Web Analytics' manual JS-snippet install and keep its automatic injection off (else double counts).
// GitHub sign-in (CLA-316, src/auth.ts): each env binds its own USERS_DB D1 database (schema in
// migrations/, applied by scripts/deploy.mjs before every deploy). Sign-in stays OFF (auth/me answers the
// public shape, /account 404s) until the env also has the secrets GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET
// and SESSION_SIGNING_KEY (>= 32 chars), set with `wrangler secret put --env <env>`, never in vars
// (asserted in test/config.test.ts). DEV_AUTH_TEST_LOGIN is local .dev.vars only. The top-level database
// id is a local-only placeholder: `wrangler dev` and the tests keep D1 on disk and never contact Cloudflare.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sourcefor-atlas",
  // Not a secret. Inherited by every env; wrangler then needs only the `wrangler login` OAuth session.
  "account_id": "204e6bcb5ef0c760a064a57f8e4dd1c0",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  // No telemetry calls from dry-run builds / local dev.
  "send_metrics": false,
  "observability": { "enabled": true },
  // The Worker runs first for every path (_headers still apply to what it passes through env.ASSETS):
  // it 301s www.sourcefor.dev before anything else, and turns the SPA fallback for a missing
  // /assets/* file into a 404 instead of index.html cached as immutable.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 4196,
    // Local dev never builds the container image (no Docker needed); API traffic goes to
    // DEV_BACKEND_ORIGIN from .dev.vars, or answers 503.
    "enable_containers": false
  },

  // ---- local dev ----
  "vars": {
    "ASK_ENABLED": "0",
    "ASK_DAILY_MAX_REQUESTS": "500",
    "BLOCK_PLAN_DAILY_MAX_REQUESTS": "200",
    "ASK_DAILY_MAX_DOLLARS": "2",
    "ASK_ESTIMATED_DOLLARS_PER_REQUEST": "0.01",
    "TURNSTILE_ENABLED": "0"
  },
  "r2_buckets": [{ "binding": "ATLAS_BUCKET", "bucket_name": "sourcefor-atlas-local" }],
  "d1_databases": [
    {
      "binding": "USERS_DB",
      "database_name": "sourcefor-atlas-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ATLAS_API", "class_name": "AtlasApiContainer" },
      { "name": "ATLAS_BUDGET", "class_name": "AtlasBudget" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AtlasApiContainer", "AtlasBudget"] }],
  "containers": [
    {
      "class_name": "AtlasApiContainer",
      "image": "../server/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "ratelimits": [{ "name": "ASK_RATE_LIMITER", "namespace_id": "2660", "simple": { "limit": 10, "period": 60 } }],

  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.sourcefor.dev", "custom_domain": true }],
      "vars": {
        "OKIE_PUBLIC_ORIGIN": "https://staging.sourcefor.dev",
        // Keep staging out of search engines: X-Robots-Tag on every response + a disallow-all robots.txt.
        "ROBOTS_NOINDEX": "1",
        // Browse-only launch: Ask and block-plan are off (and there is no container to serve them).
        "ASK_ENABLED": "0",
        // Placeholder caps pending Brenton's numbers (dormant while ASK_ENABLED is "0").
        "ASK_DAILY_MAX_REQUESTS": "500",
        "BLOCK_PLAN_DAILY_MAX_REQUESTS": "200",
        "ASK_DAILY_MAX_DOLLARS": "2",
        "ASK_ESTIMATED_DOLLARS_PER_REQUEST": "0.01",
        "TURNSTILE_ENABLED": "0"
      },
      "r2_buckets": [{ "binding": "ATLAS_BUCKET", "bucket_name": "sourcefor-atlas-staging" }],
      "d1_databases": [
        {
          "binding": "USERS_DB",
          "database_name": "sourcefor-atlas-staging",
          "database_id": "fd8be0a0-c9e3-4191-a8b3-86fb963f6447",
          "migrations_dir": "migrations"
        }
      ],
      // No container at launch: only the budget Durable Object. The signed-in-Ask follow-up adds the
      // ATLAS_API binding and the `containers` entry. The v1 migration already created AtlasApiContainer (it
      // shipped in the first deploy), so it stays listed; don't add a new migration for it.
      "durable_objects": {
        "bindings": [{ "name": "ATLAS_BUDGET", "class_name": "AtlasBudget" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AtlasApiContainer", "AtlasBudget"] }],
      "ratelimits": [{ "name": "ASK_RATE_LIMITER", "namespace_id": "2661", "simple": { "limit": 10, "period": 60 } }]
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      // www 301s to the apex in the Worker (index.ts canonicalHostRedirect).
      "routes": [
        { "pattern": "sourcefor.dev", "custom_domain": true },
        { "pattern": "www.sourcefor.dev", "custom_domain": true }
      ],
      "vars": {
        "OKIE_PUBLIC_ORIGIN": "https://sourcefor.dev",
        // Cloudflare Web Analytics site token (public; see top). Remove it and redeploy to turn analytics off.
        "WEB_ANALYTICS_TOKEN": "4860cbb249bd46c09f74a249b18212ec",
        // Browse-only launch: Ask and block-plan are off (and there is no container to serve them).
        "ASK_ENABLED": "0",
        // Placeholder caps pending Brenton's numbers (dormant while ASK_ENABLED is "0").
        "ASK_DAILY_MAX_REQUESTS": "500",
        "BLOCK_PLAN_DAILY_MAX_REQUESTS": "200",
        "ASK_DAILY_MAX_DOLLARS": "2",
        "ASK_ESTIMATED_DOLLARS_PER_REQUEST": "0.01",
        "TURNSTILE_ENABLED": "0"
      },
      "r2_buckets": [{ "binding": "ATLAS_BUCKET", "bucket_name": "sourcefor-atlas" }],
      "d1_databases": [
        {
          "binding": "USERS_DB",
          "database_name": "sourcefor-atlas",
          "database_id": "a6897908-09df-41f9-bad8-34660c00d2c7",
          "migrations_dir": "migrations"
        }
      ],
      // No container at launch: only the budget Durable Object. The signed-in-Ask follow-up adds the
      // ATLAS_API binding and the `containers` entry. The v1 migration already created AtlasApiContainer (it
      // shipped in the first deploy), so it stays listed; don't add a new migration for it.
      "durable_objects": {
        "bindings": [{ "name": "ATLAS_BUDGET", "class_name": "AtlasBudget" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AtlasApiContainer", "AtlasBudget"] }],
      "ratelimits": [{ "name": "ASK_RATE_LIMITER", "namespace_id": "2662", "simple": { "limit": 10, "period": 60 } }]
    }
  }
}
