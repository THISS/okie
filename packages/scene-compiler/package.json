{
  "name": "@okie/scene-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js",
    "generate:source-excerpts": "pnpm build && node scripts/generate-golden-source-excerpts.mjs",
    "generate:fixtures": "pnpm generate:source-excerpts && pnpm build && node dist/generate-fixtures.js"
  },
  "dependencies": {
    "@okie/architecture": "workspace:*"
  }
}
