{
  "name": "@okie/scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "okie-scan": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js",
    "scan": "pnpm build && node dist/cli.js"
  },
  "dependencies": {
    "@okie/architecture": "workspace:*",
    "@okie/scene-compiler": "workspace:*",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  }
}
